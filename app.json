{
  "expo": {
    "name": "Estação Pedro II",
    "slug": "Estacao_pedroII",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vitorsilva.estacaopedroii",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDNt0Z5V5aL_Ju5UA4-niO-PpByVy0SwBs"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-maps",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para enviar imagens das atrações."
        }
      ]
    ]
  }
}
